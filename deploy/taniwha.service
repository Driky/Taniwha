# systemd unit for Taniwha — manages the Docker container lifecycle.
#
# Installation (on the server):
#   sudo cp deploy/taniwha.service /etc/systemd/system/taniwha.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now taniwha

[Unit]
Description=Taniwha torrent manager (Docker)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

# After 3 failures within 60 s the unit enters 'failed' state to prevent
# a broken-image restart storm. Operator must intervene.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=taniwha-deploy
Group=docker

# Stop and remove any existing container from a previous run.
# The '-' prefix tells systemd to ignore a non-zero exit code
# (the container may already be stopped or not exist — that is fine).
ExecStartPre=-/usr/bin/docker stop taniwha
ExecStartPre=-/usr/bin/docker rm taniwha

# Pull the latest image. NO '-' prefix: if the pull fails and there is no
# locally cached image, ExecStart will also fail and systemd will retry
# according to the Restart policy below. This is the safe, correct behaviour.
ExecStartPre=/usr/bin/docker pull ghcr.io/driky/taniwha:latest

# The rtorrent socket's directory is mounted, not the socket file itself.
# rtorrent unlinks its socket on exit and creates a new one at each start, so
# a file bind mount would keep pointing at the dead inode after any rtorrent
# restart. RTORRENT_SOCKET is set here rather than in .env so the path always
# matches this mount; -e takes precedence over --env-file.
ExecStart=/usr/bin/docker run \
    --name taniwha \
    --rm \
    --env-file /home/taniwha-deploy/taniwha/.env \
    -e RTORRENT_SOCKET=/var/run/rtorrent/.rtorrent.sock \
    -p 4000:4000 \
    -v /var/run/driky:/var/run/rtorrent \
    -v /srv/taniwha/data:/data/taniwha \
    -v /home/driky/torrents/rtorrent:/home/driky/torrents/rtorrent \
    ghcr.io/driky/taniwha:latest

ExecStop=/usr/bin/docker stop taniwha

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
